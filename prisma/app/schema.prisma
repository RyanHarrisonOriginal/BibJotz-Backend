// Application data: users, notes, community, and non-biblical reference inventory.
// Lives in schema "jotz" on DATABASE_URL (bibjotz).
// This is the only schema we migrate.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/app-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["jotz"]
}

enum NoteScope {
  BOOK
  CHAPTER
  VERSE
  VERSE_RANGE
  VERSE_SET

  @@schema("jotz")
}

model User {
  id             Int             @id @default(autoincrement())
  displayName    String          @map("display_name") @db.VarChar(100)
  clerkUserId    String?         @unique @map("clerk_user_id") @db.VarChar(64)
  username       String?         @unique @db.VarChar(50)
  bio            String?         @db.VarChar(280)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  notes          Note[]
  referenceTypes ReferenceType[]
  references     Reference[]
  comments       NoteComment[]
  following      UserFollow[]    @relation("Following")
  followers      UserFollow[]    @relation("Followers")

  @@schema("jotz")
  @@map("users")
}

model Note {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  content           String           @db.Text
  bookName          String           @map("book_name") @db.VarChar(100)
  bookShortName     String           @map("book_short_name") @db.VarChar(20)
  chapter           Int?
  startVerse        Int?             @map("start_verse")
  endVerse          Int?             @map("end_verse")
  verseSpans        Json?            @map("verse_spans")
  scope             NoteScope
  isProfileVisible  Boolean          @default(false) @map("is_profile_visible")
  isFeedShared      Boolean          @default(false) @map("is_feed_shared")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  references        NoteReference[]
  comments          NoteComment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, bookName, chapter])
  @@schema("jotz")
  @@map("notes")
}

model ReferenceType {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  name           String       @db.VarChar(80)
  normalizedName String       @map("normalized_name") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  references     Reference[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@schema("jotz")
  @@map("reference_types")
}

model Reference {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  typeId          Int             @map("type_id")
  title           String          @db.VarChar(200)
  normalizedTitle String          @map("normalized_title") @db.VarChar(200)
  author          String?         @db.VarChar(200)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            ReferenceType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  noteTags        NoteReference[]

  @@unique([userId, typeId, normalizedTitle])
  @@index([userId])
  @@index([typeId])
  @@schema("jotz")
  @@map("references")
}

model NoteReference {
  id          Int       @id @default(autoincrement())
  noteId      Int       @map("note_id")
  referenceId Int       @map("reference_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([noteId, referenceId])
  @@index([referenceId])
  @@schema("jotz")
  @@map("note_references")
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId], map: "user_follows_unique")
  @@index([followingId], map: "user_follows_following_idx")
  @@schema("jotz")
  @@map("user_follows")
}

model NoteComment {
  id        Int       @id @default(autoincrement())
  noteId    Int       @map("note_id")
  userId    Int       @map("user_id")
  content   String    @db.VarChar(1000)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@index([userId])
  @@schema("jotz")
  @@map("note_comments")
}
