{
  "name": "bib-jotz-api",
  "version": "1.0.0",
  "description": "BibJotz API — Bible reading and note-taking. DDD, CQRS, ports and adapters.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "start": "node -r module-alias/register dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "lint": "eslint src/**/*.ts",
    "db:generate": "npm run db:generate:bible && npm run db:generate:app",
    "db:generate:bible": "prisma generate --schema prisma/bible/schema.prisma",
    "db:generate:app": "prisma generate --schema prisma/app/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/app/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/app/schema.prisma",
    "db:studio": "prisma studio --schema prisma/app/schema.prisma",
    "db:studio:bible": "prisma studio --schema prisma/bible/schema.prisma",
    "postinstall": "npm run db:generate"
  },
  "keywords": [
    "express",
    "typescript",
    "cqrs",
    "ddd",
    "bible"
  ],
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@prisma/client": "^6.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "prisma": "^6.16.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
