# Scripture corpus (schema "app"). Read-only.
BIBLE_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/bible_database?sslmode=require&channel_binding=require

# Notes and users (schema "jotz"). Prisma migrate/push use this URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/bibjotz?sslmode=require&channel_binding=require

PORT=3002
NODE_ENV=development

# Same Clerk instance as the mobile app
CLERK_SECRET_KEY=sk_test_...
# Optional comma-separated authorized parties for JWT azp validation (e.g. exp://127.0.0.1:8081)
# CLERK_AUTHORIZED_PARTIES=